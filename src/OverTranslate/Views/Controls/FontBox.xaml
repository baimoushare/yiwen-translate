<UserControl x:Class="OverTranslate.Views.Controls.FontBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Same contract as ModelBox/SecretBox: the frame lives on the outer Border so the editor
             and the drop button read as one input box; the inner editor is stripped of its chrome. -->
        <Style x:Key="EditorChrome" TargetType="TextBox">
            <Setter Property="FontFamily"               Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"                 Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground"               Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="9,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DropButton" TargetType="Button">
            <Setter Property="Width"      Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="0,6,6,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 一行一个字体。选中/悬停用 AppAccentSubtle，与应用其它列表同观感。 -->
        <Style x:Key="FontRow" TargetType="ListBoxItem">
            <Setter Property="Focusable"    Value="False"/>
            <Setter Property="Foreground"   Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"     Value="{StaticResource AppFontSize}"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Root"
                Background="{DynamicResource AppInputBg}"
                CornerRadius="6"
                Height="34">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush"     Value="{DynamicResource AppInputBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Value="True"
                                     Binding="{Binding IsKeyboardFocusWithin,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource AppInputFocusBorder}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 输入框即搜索框：聚焦时全选，打字即过滤列表 -->
                <TextBox x:Name="FontInput" Grid.Column="0"
                         Style="{StaticResource EditorChrome}"
                         CaretBrush="{DynamicResource AppTextPrimary}"
                         SelectionBrush="{DynamicResource AppAccent}"
                         GotKeyboardFocus="FontInput_GotKeyboardFocus"
                         TextChanged="FontInput_TextChanged"
                         PreviewKeyDown="FontInput_PreviewKeyDown"/>

                <Button x:Name="DropBtn" Grid.Column="1"
                        Style="{StaticResource DropButton}"
                        Click="DropBtn_Click"
                        ToolTip="{DynamicResource S.Settings.UiFont}">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10"
                               Text="&#xE70D;"/>
                </Button>
            </Grid>
        </Border>

        <!-- 与 ModelBox 同款弹出列表：StaysOpen=False 点击外部即关 -->
        <Popup x:Name="ListPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Root}"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Closed="ListPopup_Closed">
            <Border Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="8,4,8,8"
                    Width="{Binding ActualWidth, ElementName=Root}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="NoMatchText"
                               Visibility="Collapsed"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{StaticResource AppFontSize}"
                               Foreground="{DynamicResource AppTextSecondary}"
                               Margin="12,10,12,10"
                               Text="{DynamicResource S.Settings.UiFontNoMatch}"/>
                    <ScrollViewer x:Name="ListHost"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="FontList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource FontRow}"
                                 SelectionChanged="FontList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
